<section
  id="contact"
  class="bg-[#f5f1ea] px-6 py-24 sm:py-32 lg:px-8"
>
  <div class="mx-auto max-w-7xl">
    <div
      class="overflow-hidden rounded-[2rem] bg-stone-900 text-white"
    >
      <div class="grid lg:grid-cols-2">

        <!-- Information -->
        <div class="p-8 sm:p-12 lg:p-16">
          <p
            class="text-xs font-medium uppercase tracking-[0.3em] text-amber-300/70"
          >
            Find us
          </p>

          <h2
            class="mt-5 max-w-lg text-4xl font-medium leading-tight tracking-[-0.035em] sm:text-5xl"
          >
            Your next coffee
            <span class="font-serif italic text-amber-200">
              is waiting.
            </span>
          </h2>

          <p class="mt-6 max-w-md text-sm leading-7 text-white/50">
            Drop by for a quiet morning, an afternoon catch-up or simply a
            beautifully crafted cup of coffee.
          </p>

          <div class="mt-10 grid gap-7 sm:grid-cols-2 lg:grid-cols-1">

            <div>
              <p class="text-[10px] uppercase tracking-[0.25em] text-white/30">
                Location
              </p>

              <p class="mt-2 text-sm leading-6 text-white/80">
                Downtown Dubai<br />
                Dubai, United Arab Emirates
              </p>
            </div>

            <div>
              <p class="text-[10px] uppercase tracking-[0.25em] text-white/30">
                Opening hours
              </p>

              <p class="mt-2 text-sm leading-6 text-white/80">
                Monday — Sunday<br />
                7:00 AM — 12:00 AM
              </p>
            </div>

          </div>

          <div class="mt-10 flex flex-wrap gap-3">
            <a
              href="https://maps.google.com/"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center rounded-full bg-white px-6 py-3 text-sm font-medium text-stone-950 transition hover:bg-amber-100"
            >
              Get Directions
            </a>

            <a
              href="tel:+971000000000"
              class="inline-flex items-center rounded-full border border-white/15 px-6 py-3 text-sm font-medium text-white transition hover:bg-white/5"
            >
              Call Us
            </a>
          </div>
        </div>

        <!-- Visual -->
        <div
          class="relative min-h-[380px] overflow-hidden border-t border-white/10 bg-gradient-to-br from-stone-800 via-stone-900 to-black lg:min-h-full lg:border-l lg:border-t-0"
        >
          <div
            class="absolute inset-0 bg-[radial-gradient(circle_at_50%_45%,rgba(217,119,6,0.22),transparent_30%)]"
          ></div>

          <!-- Minimal map-inspired visual -->
          <div class="absolute inset-8 rounded-[1.5rem] border border-white/10">
            <div class="absolute left-[20%] top-[28%] h-px w-[60%] rotate-[20deg] bg-white/10"></div>

            <div class="absolute left-[10%] top-[55%] h-px w-[75%] -rotate-[14deg] bg-white/10"></div>

            <div class="absolute left-[35%] top-[15%] h-[75%] w-px rotate-[25deg] bg-white/10"></div>

            <div class="absolute bottom-[25%] right-[20%] h-px w-[45%] rotate-[65deg] bg-white/10"></div>

            <!-- Location marker -->
            <div
              class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2"
            >
              <div
                class="flex h-14 w-14 items-center justify-center rounded-full bg-amber-300 text-stone-950 shadow-[0_0_0_12px_rgba(252,211,77,0.08)]"
              >
                <span class="text-lg">✦</span>
              </div>

              <div
                class="mt-4 rounded-full border border-white/10 bg-black/50 px-4 py-2 text-center text-[10px] uppercase tracking-[0.2em] text-white/60 backdrop-blur-md"
              >
                Café Lumière
              </div>
            </div>
          </div>

          <div class="absolute bottom-7 left-7">
            <p class="text-[10px] uppercase tracking-[0.3em] text-white/30">
              Dubai · UAE
            </p>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>