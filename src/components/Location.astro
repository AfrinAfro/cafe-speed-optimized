---
---

<section
  id="location"
  class="bg-[#f5f1ea] px-6 py-24 sm:py-32 lg:px-8"
>
  <div
    class="mx-auto grid max-w-7xl overflow-hidden rounded-[2rem] bg-[#171514] text-white lg:grid-cols-2"
  >
    <!-- Content -->
    <div class="flex flex-col justify-center px-8 py-12 sm:px-12 sm:py-16 lg:px-14 lg:py-20">

      <p
        class="text-[10px] font-medium uppercase tracking-[0.3em] text-amber-300"
      >
        Find us
      </p>

      <h2
        class="mt-5 max-w-md text-4xl font-medium leading-[1.05] tracking-[-0.04em] sm:text-5xl"
      >
        Your next coffee is
        <span class="font-serif italic text-amber-200">
          waiting.
        </span>
      </h2>

      <p
        class="mt-6 max-w-md text-sm leading-7 text-white/45"
      >
        Drop by for a quiet morning, an afternoon catch-up or simply a
        beautifully crafted cup of coffee.
      </p>

      <!-- Location -->
      <div class="mt-9">
        <p
          class="text-[9px] uppercase tracking-[0.25em] text-white/30"
        >
          Location
        </p>

        <address
          class="mt-3 not-italic text-sm leading-6 text-white/80"
        >
          Downtown Dubai<br />
          Dubai, United Arab Emirates
        </address>
      </div>

      <!-- Hours -->
      <div class="mt-7">
        <p
          class="text-[9px] uppercase tracking-[0.25em] text-white/30"
        >
          Opening hours
        </p>

        <p class="mt-3 text-sm leading-6 text-white/80">
          Monday — Sunday<br />
          7:00 AM — 12:00 AM
        </p>
      </div>

      <!-- Actions -->
      <div class="mt-9 flex flex-wrap gap-3">
        <a
          href="https://www.google.com/maps/search/?api=1&query=Downtown%20Dubai%2C%20Dubai%2C%20United%20Arab%20Emirates"
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-full bg-white px-5 py-3 text-xs font-medium text-stone-900 transition hover:bg-amber-100"
        >
          Get Directions
        </a>

        <a
          href="#contact"
          class="rounded-full border border-white/15 px-5 py-3 text-xs font-medium text-white transition hover:border-white/30 hover:bg-white/5"
        >
          Contact Us
        </a>
      </div>
    </div>

    <!-- Map visual -->
    <div class="relative min-h-[420px] overflow-hidden bg-[#11100f] lg:min-h-[620px]">

      <!-- Ambient glow -->
      <div
        class="absolute left-1/2 top-1/2 h-64 w-64 -translate-x-1/2 -translate-y-1/2 rounded-full bg-amber-700/10 blur-[90px]"
      ></div>

      <!-- Map lines -->
      <div class="absolute inset-0 opacity-40">
        <div
          class="absolute left-[8%] top-[18%] h-px w-[80%] rotate-[18deg] bg-white/10"
        ></div>

        <div
          class="absolute left-[5%] top-[62%] h-px w-[90%] rotate-[-13deg] bg-white/10"
        ></div>

        <div
          class="absolute left-[20%] top-[80%] h-px w-[70%] rotate-[63deg] bg-white/10"
        ></div>

        <div
          class="absolute left-[40%] top-[5%] h-px w-[70%] rotate-[110deg] bg-white/10"
        ></div>

        <div
          class="absolute left-[15%] top-[40%] h-px w-[75%] rotate-[-35deg] bg-white/10"
        ></div>
      </div>

      <!-- Location marker -->
      <div
        class="absolute left-1/2 top-1/2 flex -translate-x-1/2 -translate-y-1/2 items-center justify-center"
      >
        <div
          class="absolute h-28 w-28 animate-pulse rounded-full bg-amber-400/10"
        ></div>

        <div
          class="absolute h-20 w-20 rounded-full border border-amber-300/20 bg-amber-400/10"
        ></div>

        <div
          class="relative flex h-12 w-12 items-center justify-center rounded-full bg-amber-300 text-stone-950 shadow-[0_0_40px_rgba(251,191,36,0.35)]"
        >
          <span class="text-sm">✦</span>
        </div>
      </div>

      <!-- Location label -->
      <div
        class="absolute bottom-7 left-7 right-7 flex items-end justify-between"
      >
        <div>
          <p class="text-[9px] uppercase tracking-[0.25em] text-white/30">
            Café Lumière
          </p>

          <p class="mt-2 text-xs text-white/60">
            Downtown Dubai
          </p>
        </div>

        <span
          class="rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-[9px] uppercase tracking-[0.2em] text-white/40"
        >
          Dubai · UAE
        </span>
      </div>

    </div>
  </div>
</section>