---
import { Image } from "astro:assets";
import aboutImage from "../assets/images/about.png";
---

<section id="story" class="bg-[#f5f1ea] px-6 py-24 sm:py-32 lg:px-8">
  <div class="mx-auto max-w-7xl">
    <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-20">

      <!-- Image -->
      <div class="relative overflow-hidden rounded-[2rem]">
        <Image
          src={aboutImage}
          alt="Warm and inviting interior of Café Lumière"
          width={1536}
          height={1024}
          loading="lazy"
          decoding="async"
          class="h-[420px] w-full object-cover sm:h-[520px] lg:h-[640px]"
        />

        <!-- Small decorative label -->
        <div
          class="absolute bottom-5 left-5 rounded-full border border-white/20 bg-black/30 px-4 py-2 text-[10px] uppercase tracking-[0.25em] text-white backdrop-blur-md"
        >
          Café Lumière · Dubai
        </div>
      </div>

      <!-- Content -->
      <div class="lg:pl-4">

        <p
          class="text-xs font-medium uppercase tracking-[0.3em] text-amber-800"
        >
          Our story
        </p>

        <h2
          class="mt-5 max-w-xl text-4xl font-medium leading-[1.05] tracking-[-0.04em] text-stone-900 sm:text-5xl lg:text-6xl"
        >
          More than coffee.
          <span class="block font-serif italic text-stone-500">
            A moment to slow down.
          </span>
        </h2>

        <div class="mt-7 max-w-lg space-y-5 text-sm leading-7 text-stone-500 sm:text-base">
          <p>
            Café Lumière was created around a simple idea: great coffee should
            feel unhurried.
          </p>

          <p>
            From carefully selected beans to thoughtful preparation, every
            detail is designed to create a space where good coffee and good
            conversation naturally belong together.
          </p>
        </div>

        <!-- Small stats -->
        <div class="mt-10 grid max-w-lg grid-cols-2 gap-8 border-t border-stone-200 pt-8">

          <div>
            <p class="text-2xl font-medium tracking-tight text-stone-900">
              01
            </p>

            <p class="mt-2 text-[10px] uppercase tracking-[0.2em] text-stone-400">
              Thoughtful space
            </p>
          </div>

          <div>
            <p class="text-2xl font-medium tracking-tight text-stone-900">
              100%
            </p>

            <p class="mt-2 text-[10px] uppercase tracking-[0.2em] text-stone-400">
              Crafted with care
            </p>
          </div>

        </div>

      </div>

    </div>
  </div>
</section>