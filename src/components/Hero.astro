---
import { Image } from "astro:assets";
import heroImage from "../assets/images/hero.png";
---

<section
  class="relative isolate min-h-[92svh] overflow-hidden bg-stone-950"
>
  <!-- Hero image -->
  <Image
    src={heroImage}
    alt="Warm, intimate interior of a modern specialty coffee shop"
    width={1536}
    height={1024}
    class="absolute inset-0 -z-20 h-full w-full object-cover object-center"
    loading="eager"
    fetchpriority="high"
    decoding="async"
  />

  <!-- Dark overlay -->
  <div
    class="absolute inset-0 -z-10 bg-gradient-to-r from-stone-950 via-stone-950/75 to-stone-950/20"
  ></div>

  <!-- Additional bottom gradient -->
  <div
    class="absolute inset-x-0 bottom-0 -z-10 h-48 bg-gradient-to-t from-stone-950/80 to-transparent"
  ></div>

  <div
    class="mx-auto flex min-h-[92svh] max-w-7xl items-end px-6 pb-20 pt-32 sm:pb-24 lg:px-8"
  >
    <div class="max-w-3xl">

      <!-- Eyebrow -->
      <p
        class="mb-6 text-xs font-medium uppercase tracking-[0.32em] text-amber-200/80"
      >
        Specialty coffee · Dubai
      </p>

      <!-- Main heading -->
      <h1
        class="max-w-3xl text-5xl font-medium leading-[0.95] tracking-[-0.045em] text-white sm:text-6xl md:text-7xl lg:text-8xl"
      >
        Coffee,
        <span class="block font-serif italic text-amber-100">
          thoughtfully crafted.
        </span>
      </h1>

      <!-- Description -->
      <p
        class="mt-7 max-w-xl text-sm leading-7 text-white/65 sm:text-base"
      >
        A quiet corner for exceptional coffee, honest ingredients and
        beautifully unhurried moments.
      </p>

      <!-- CTA -->
      <div class="mt-9 flex flex-wrap gap-3">

        <a
          href="#menu"
          class="rounded-full bg-white px-7 py-3.5 text-sm font-medium text-stone-950 transition duration-300 hover:bg-amber-100"
        >
          Explore the Menu
        </a>

        <a
          href="#story"
          class="rounded-full border border-white/20 bg-white/5 px-7 py-3.5 text-sm font-medium text-white backdrop-blur-sm transition duration-300 hover:border-white/40 hover:bg-white/10"
        >
          Our Story
        </a>

      </div>

    </div>
  </div>

  <!-- Scroll indicator -->
  <a
    href="#story"
    aria-label="Scroll to our story"
    class="absolute bottom-8 right-6 hidden items-center gap-3 text-[10px] uppercase tracking-[0.25em] text-white/40 sm:flex lg:right-8"
  >
    <span>Scroll</span>

    <span class="h-10 w-px bg-white/20"></span>
  </a>
</section>