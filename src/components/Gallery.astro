---
import { Image } from "astro:assets";

import coffeeCraft from "../assets/images/coffee-craft.jpg";
import cafeDetail from "../assets/images/cafe-detail.jpg";
import slowMoment from "../assets/images/slow-moment.jpg";
import cafeSpace from "../assets/images/cafe-space.jpg";

const galleryItems = [
  {
    image: cafeSpace,
    alt: "Bright and elegant interior of Café Lumière",
    className: "md:col-span-2 md:row-span-2",
  },
  {
    image: slowMoment,
    alt: "Coffee and pastry served at a cafe table",
    className: "",
  },
  {
    image: coffeeCraft,
    alt: "Barista carefully preparing specialty coffee",
    className: "",
  },
  {
    image: cafeDetail,
    alt: "Warmly lit cafe bar and interior details",
    className: "md:col-span-2",
  },
];
---

<section id="gallery" class="bg-[#f5f1ea] px-6 py-24 sm:py-32 lg:px-8">
  <div class="mx-auto max-w-7xl">

    <!-- Heading -->
    <div class="max-w-2xl">
      <p
        class="text-xs font-medium uppercase tracking-[0.3em] text-amber-800"
      >
        Inside Café Lumière
      </p>

     <h2
  class="mt-5 text-4xl font-medium leading-[1.05] tracking-[-0.04em] text-stone-900 sm:text-5xl lg:text-6xl"
>
  A space made
  <span class="block font-serif italic text-stone-500">
    for lingering.
  </span>
</h2>

      <p class="mt-6 max-w-lg text-sm leading-7 text-stone-500 sm:text-base">
        From the first pour to the last conversation, every corner is designed
        to make ordinary moments feel a little more special.
      </p>
    </div>

    <!-- Gallery -->
    <div
      class="mt-14 grid auto-rows-[220px] grid-cols-1 gap-4 sm:auto-rows-[260px] md:grid-cols-4 md:auto-rows-[220px]"
    >
      {galleryItems.map((item) => (
        <figure
          class:list={[
            "group relative overflow-hidden rounded-[1.5rem]",
            item.className,
          ]}
        >
          <Image
            src={item.image}
            alt={item.alt}
            width={1200}
            height={900}
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover transition duration-700 ease-out group-hover:scale-105"
          />

          <div
            class="absolute inset-0 bg-gradient-to-t from-black/35 via-transparent to-transparent opacity-70 transition duration-500 group-hover:opacity-90"
          ></div>
        </figure>
      ))}
    </div>

  </div>
</section>