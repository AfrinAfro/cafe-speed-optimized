---
import { Image } from "astro:assets";

import pistachioLatte from "../assets/images/pistachio-latte.jpg";
import almondCroissant from "../assets/images/almond-croissant.jpg";
import coldBrew from "../assets/images/cold-brew.jpg";

const menuItems = [
  {
    name: "Pistachio Latte",
    description: "Velvety espresso, pistachio cream and steamed milk.",
    price: "AED 28",
    image: pistachioLatte,
    alt: "Pistachio latte served in a ceramic cup",
  },
  {
    name: "Almond Croissant",
    description: "Buttery laminated pastry with roasted almond cream.",
    price: "AED 22",
    image: almondCroissant,
    alt: "Golden almond croissant served with coffee",
  },
  {
    name: "Cold Brew",
    description: "Slow-steeped specialty coffee served over ice.",
    price: "AED 24",
    image: coldBrew,
    alt: "Cold brew coffee served over ice in a glass",
  },
];
---

<section id="menu" class="bg-stone-900 px-6 py-24 text-white sm:py-32 lg:px-8">
  <div class="mx-auto max-w-7xl">

    <!-- Heading -->
    <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p
          class="text-xs font-medium uppercase tracking-[0.3em] text-amber-300/70"
        >
          Signature menu
        </p>

      <h2
  class="mt-5 max-w-2xl text-4xl font-medium leading-[1.05] tracking-[-0.04em] sm:text-5xl lg:text-6xl"
>
  Simple ingredients.
  <span class="block font-serif italic text-white/50">
    Beautifully made.
  </span>
</h2>
      </div>

      <a
        href="#contact"
        class="hidden shrink-0 text-xs font-medium uppercase tracking-[0.2em] text-white/50 transition hover:text-white sm:block"
      >
        Visit us →
      </a>
    </div>

    <!-- Menu cards -->
    <div class="mt-14 grid gap-6 md:grid-cols-3">

      {menuItems.map((item) => (
        <article class="group overflow-hidden rounded-[1.75rem] border border-white/10 bg-white/[0.035]">

          <!-- Image -->
          <div class="relative aspect-[4/3] overflow-hidden">
            <Image
              src={item.image}
              alt={item.alt}
              width={900}
              height={675}
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover transition duration-700 ease-out group-hover:scale-105"
            />

            <!-- Image overlay -->
            <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent"></div>

            <!-- Price -->
            <span
              class="absolute right-4 top-4 rounded-full border border-white/15 bg-black/30 px-3 py-1.5 text-xs font-medium text-white backdrop-blur-md"
            >
              {item.price}
            </span>
          </div>

          <!-- Content -->
          <div class="p-6">
            <h3 class="text-xl font-medium tracking-tight">
              {item.name}
            </h3>

            <p class="mt-3 text-sm leading-6 text-white/45">
              {item.description}
            </p>
          </div>

        </article>
      ))}

    </div>

    <!-- Bottom note -->
    <div class="mt-10 flex items-center gap-4 text-xs text-white/25">
      <span class="h-px w-10 bg-white/10"></span>
      <span>Seasonal ingredients · Thoughtful preparation</span>
    </div>

  </div>
</section>