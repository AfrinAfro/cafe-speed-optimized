---
const experiences = [
  {
    number: "01",
    title: "Thoughtful sourcing",
    description:
      "We choose specialty beans for character, clarity and a naturally memorable cup.",
  },
  {
    number: "02",
    title: "Genuine hospitality",
    description:
      "Inspired by the warmth of the UAE, every guest should feel welcomed, comfortable and at home.",
    featured: true,
  },
];
---

<section
  id="experience"
  class="overflow-hidden bg-[#0d0c0b] px-6 py-24 text-white sm:py-32 lg:px-8"
>
  <div class="mx-auto max-w-7xl">

    <!-- Heading -->
    <div class="max-w-3xl">
      <p
        class="text-[10px] font-medium uppercase tracking-[0.3em] text-amber-300"
      >
        The experience
      </p>

      <h2
        class="mt-5 text-4xl font-medium leading-[1.02] tracking-[-0.045em] sm:text-5xl lg:text-7xl"
      >
        Coffee is only part of
        <span class="font-serif italic text-amber-200">
          the experience.
        </span>
      </h2>
    </div>

    <!-- Experience grid -->
    <div class="mt-14 grid gap-3 lg:grid-cols-[minmax(0,1fr)_190px]">

      <!-- Main story card -->
      <article
        class="group relative min-h-[390px] overflow-hidden rounded-[1.75rem] border border-white/10 bg-[#171513]"
      >
        <!-- Ambient light -->
        <div
          class="absolute -left-24 -top-20 h-72 w-72 rounded-full bg-amber-700/20 blur-[90px] transition duration-700 group-hover:bg-amber-600/30"
        ></div>

        <div
          class="absolute -bottom-24 right-10 h-64 w-64 rounded-full bg-orange-900/20 blur-[90px]"
        ></div>

        <!-- Abstract coffee ring -->
        <div
          class="absolute left-1/2 top-1/2 flex h-28 w-28 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full border border-white/10 bg-white/[0.03] shadow-[0_0_80px_rgba(245,158,11,0.12)]"
        >
          <div
            class="h-20 w-20 rounded-full border border-amber-400/20 bg-amber-700/10"
          ></div>

          <div
            class="absolute h-14 w-14 rounded-full border border-amber-300/10"
          ></div>
        </div>

        <!-- Content -->
        <div class="absolute inset-x-0 bottom-0 p-7 sm:p-9">

          <p
            class="text-[9px] uppercase tracking-[0.25em] text-white/35"
          >
            01 — Craft
          </p>

          <h3
            class="mt-3 text-2xl font-medium tracking-tight sm:text-3xl"
          >
            Every cup begins with intention.
          </h3>

          <p
            class="mt-3 max-w-lg text-xs leading-6 text-white/45 sm:text-sm"
          >
            From the first aroma to the final pour, our baristas focus on
            balance, detail and consistency.
          </p>

        </div>
      </article>

      <!-- Side cards -->
      <div class="grid gap-3">

        {experiences.map((experience) => (
          <article
            class:list={[
              "flex min-h-[190px] flex-col justify-between rounded-[1.5rem] border p-5 sm:p-6",
              experience.featured
                ? "border-amber-100/20 bg-amber-100 text-stone-900"
                : "border-white/10 bg-[#171513] text-white",
            ]}
          >
            <span
              class:list={[
                "flex h-6 w-6 items-center justify-center rounded-full border text-[9px]",
                experience.featured
                  ? "border-stone-900/10"
                  : "border-amber-300/30 text-amber-300",
              ]}
            >
              {experience.number}
            </span>

            <div>
              <h3 class="text-sm font-medium">
                {experience.title}
              </h3>

              <p
                class:list={[
                  "mt-2 text-[10px] leading-5",
                  experience.featured
                    ? "text-stone-600"
                    : "text-white/40",
                ]}
              >
                {experience.description}
              </p>
            </div>
          </article>
        ))}

      </div>
    </div>

    <!-- Bottom statement -->
    <div
      class="mt-8 flex flex-col gap-5 border-t border-white/10 pt-6 sm:flex-row sm:items-center sm:justify-between"
    >
      <p class="max-w-xl text-xs leading-6 text-white/30">
        A place for the morning ritual, the afternoon conversation and the
        unexpected pause in between.
      </p>

      <a
        href="#location"
        class="shrink-0 text-[10px] font-medium uppercase tracking-[0.2em] text-amber-200 transition hover:text-white"
      >
        Plan your visit →
      </a>
    </div>

  </div>
</section>