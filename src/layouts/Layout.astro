---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Café Lumière | Premium Coffee Experience",
  description = "Experience exceptional coffee, handcrafted pastries, and warm hospitality in the heart of the UAE.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1c1917" />

    <title>{title}</title>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>

  <body id="top">
    <slot />
  </body>
</html>